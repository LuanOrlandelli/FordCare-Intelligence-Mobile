# FordCare Intelligence - Frontend

# URL pública utilizada pelo aplicativo para acessar a API.
#
# Web local:
# EXPO_PUBLIC_API_URL=http://localhost:8080
#
# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
#
# Dispositivo físico:
# EXPO_PUBLIC_API_URL=http://IP_DO_COMPUTADOR:8080
#
# Nunca coloque senhas, JWT_SECRET ou credenciais privadas
# em variáveis EXPO_PUBLIC_*.

EXPO_PUBLIC_API_URL=http://localhost:8080